<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.papegames.nn4.vivo" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ReturnTestActivity"
            android:exported="false" />

        <activity
            android:name=".TaskSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".GuideReviewActivity"
            android:exported="false" />

        <activity
            android:name=".ScreenshotViewerActivity"
            android:exported="false" />

        <activity
            android:name=".ScreenshotAnnotateActivity"
            android:exported="false" />

        <activity
            android:name=".BranchConditionActivity"
            android:exported="false" />

        <service
            android:name=".ProbeAccessibilityService"
            android:exported="false"
            android:label="闪暖日活校准"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
